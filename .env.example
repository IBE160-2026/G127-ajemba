# Copy this file to .env to change settings. The app also starts with no .env.

# local (or unset) = development: DEBUG on, a built-in development key is used.
# Any other value = DEBUG off, and SECRET_KEY below is then required.
RECALL_ENV=local

# Required when RECALL_ENV is not local. Never commit a real key.
SECRET_KEY=

# Comma-separated host names the app answers to.
ALLOWED_HOSTS=localhost,127.0.0.1

# Uploads allowed per user per day (default 5).
UPLOADS_PER_DAY=5

# The "day" for that limit starts at midnight in this time zone (default Europe/Oslo).
LIMIT_TIME_ZONE=Europe/Oslo

# AI calls allowed per user per day, and for everybody together (default 30 and 200).
# When either is used up, no new job is queued and the user sees a message.
AI_CALLS_PER_USER_PER_DAY=30
AI_CALLS_GLOBAL_PER_DAY=200
