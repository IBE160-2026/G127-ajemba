# Copy this file to .env to change settings. The app also starts with no .env.

# local (or unset) = development: DEBUG on, a built-in development key is used.
# Any other value = DEBUG off, and SECRET_KEY below is then required.
RECALL_ENV=local

# Required when RECALL_ENV is not local. Never commit a real key.
SECRET_KEY=

# Comma-separated host names the app answers to.
ALLOWED_HOSTS=localhost,127.0.0.1
